DATABASE_URL=postgresql://lineage2:lineage2@127.0.0.1:5432/lineage2
PORT=4173
HOST=127.0.0.1
# local is a trusted single-user mode restricted to loopback.
AUTH_MODE=local
# Private mode requires an explicit origin; use HTTPS outside loopback.
# PUBLIC_ORIGIN=https://family.example.com
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# SETUP_TOKEN=replace-with-a-random-secret-at-least-32-characters
SESSION_COOKIE_SECURE=true
# Enable only when your trusted reverse proxy connects over loopback.
TRUST_PROXY=false
# Optional PostgreSQL client executable paths for db:backup / db:restore.
# PG_DUMP_BIN=/usr/bin/pg_dump
# PG_RESTORE_BIN=/usr/bin/pg_restore
